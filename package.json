{
  "name": "dsh-deepseek-usage-panel",
  "version": "0.2.2",
  "description": "Floating macOS-glass DeepSeek usage panel for the DSH web UI: live official balance + token usage (today, session, 24 h smooth trend, per model) without opening platform.deepseek.com/usage. · DSH 毛玻璃用量面板：官方余额 + Token 用量",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WeiyangPro/dsh-usage-panel"
  },
  "homepage": "https://github.com/WeiyangPro/dsh-usage-panel",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "usage",
    "balance",
    "tokens",
    "quota",
    "panel",
    "deepseek-harness",
    "dsh-usage",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "id": "dsh-deepseek-usage-panel",
    "name": "用量面板",
    "version": "0.2.2",
    "repo": "WeiyangPro/dsh-usage-panel",
    "permissions": "读取配置的 DeepSeek API Key 轮询 GET /user/balance；监听 session/event 用量；注册 /dsh-usage/api HTTP 路由；在数据目录保存滚动用量历史",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
